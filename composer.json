{
    "name": "uxi360/guest-entries-notification",
    "description": "Email notifications for entries submitted through the Guest Entries plugin.",
    "type": "craft-plugin",
    "version": "3.0.0",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "craft-plugin",
        "guest entries notification"
    ],
    "support": {
        "docs": "https://github.com/bhashkar007/guest-entries-notification/blob/master/README.md",
        "issues": "https://github.com/bhashkar007/guest-entries-notification/issues"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "UXI360 InfoTech",
            "homepage": "https://uxi360.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "craftcms/cms": "^5.0.0",
        "craftcms/guest-entries": "^4.0.0"
    },
    "autoload": {
        "psr-4": {
            "uxi360\\guestentriesnotification\\": "src/"
        }
    },
    "extra": {
        "name": "Guest Entries Notification",
        "handle": "guest-entries-notification",
        "changelogUrl": "https://raw.githubusercontent.com/bhashkar007/guest-entries-notification/master/CHANGELOG.md",
        "class": "uxi360\\guestentriesnotification\\GuestEntriesNotification"
    }
}
