{# Guest Entries Notification plugin settings #}

{% import "_includes/forms" as forms %}

{% if not guestEntriesAvailable %}
    <blockquote class="note warning">
        <p>{{ 'The Guest Entries plugin isn’t installed or enabled. Guest Entries Notification can’t send any notifications without it.'|t('guest-entries-notification') }}</p>
    </blockquote>
{% endif %}

<h2>{{ 'Sender'|t('guest-entries-notification') }}</h2>

{{ forms.textField({
    label: 'From Email'|t('guest-entries-notification'),
    instructions: 'The address notification emails are sent from. Leave blank to use the system email address.'|t('guest-entries-notification'),
    id: 'fromEmail',
    name: 'fromEmail',
    placeholder: systemFromEmail,
    value: settings.fromEmail,
    errors: settings.getErrors('fromEmail'),
}) }}

{{ forms.textField({
    label: 'From Name'|t('guest-entries-notification'),
    instructions: 'The sender name. Leave blank to use the system sender name.'|t('guest-entries-notification'),
    id: 'fromName',
    name: 'fromName',
    placeholder: systemFromName,
    value: settings.fromName,
}) }}

{{ forms.textField({
    label: 'Reply-To'|t('guest-entries-notification'),
    instructions: 'Where replies should go. This can be an entry value, such as `{email}` for a field with the handle `email`, so you can reply straight to the person who submitted the entry.'|t('guest-entries-notification'),
    id: 'replyTo',
    name: 'replyTo',
    value: settings.replyTo,
}) }}

<hr>

<h2>{{ 'Recipients'|t('guest-entries-notification') }}</h2>

{{ forms.textField({
    label: 'Email'|t('guest-entries-notification'),
    instructions: 'Who receives the notification. Separate several addresses with commas. Leave blank to use the system email address.'|t('guest-entries-notification'),
    id: 'emailTo',
    name: 'emailTo',
    placeholder: systemFromEmail,
    value: settings.emailTo,
}) }}

{{ forms.textField({
    label: 'CC'|t('guest-entries-notification'),
    instructions: 'Separate several addresses with commas.'|t('guest-entries-notification'),
    id: 'cc',
    name: 'cc',
    value: settings.cc,
}) }}

{{ forms.textField({
    label: 'BCC'|t('guest-entries-notification'),
    instructions: 'Separate several addresses with commas.'|t('guest-entries-notification'),
    id: 'bcc',
    name: 'bcc',
    value: settings.bcc,
}) }}

<hr>

<h2>{{ 'Message'|t('guest-entries-notification') }}</h2>

{{ forms.textField({
    label: 'Email Subject'|t('guest-entries-notification'),
    instructions: 'The subject line. It can include entry values, such as `New entry: {title}` or `{{ entry.section.name }}: {title}`.'|t('guest-entries-notification'),
    id: 'emailSubject',
    name: 'emailSubject',
    value: settings.emailSubject,
}) }}

{{ forms.textField({
    label: 'Email Template'|t('guest-entries-notification'),
    instructions: 'Path of a template in your `templates/` folder to use for the email body. It receives `entry`, `subject` and `isTest` variables. Leave blank to use the built-in template. A plain-text version is generated from it automatically.'|t('guest-entries-notification'),
    id: 'confirmationTemplate',
    name: 'confirmationTemplate',
    class: 'code',
    placeholder: '_emails/guest-entry',
    value: settings.confirmationTemplate,
}) }}

{{ forms.lightswitchField({
    label: 'Send through the queue'|t('guest-entries-notification'),
    instructions: 'Send notifications in a background job, so the form responds straight away and a mail problem can be retried. Turn this off to send the email while the form is being submitted.'|t('guest-entries-notification'),
    id: 'useQueue',
    name: 'useQueue',
    on: settings.useQueue,
}) }}

<hr>

{% if sectionRows|length %}
    {{ forms.editableTableField({
        label: 'Section Settings'|t('guest-entries-notification'),
        instructions: 'Only sections that allow guest submissions in the Guest Entries plugin are listed. Notifications are off until you turn on Notify for a section. A section can also have its own recipients, subject or template; blank cells use the settings above.'|t('guest-entries-notification'),
        id: 'sections',
        name: 'sections',
        cols: {
            heading: {
                type: 'heading',
                heading: 'Section'|t('app'),
                thin: true,
            },
            enabled: {
                type: 'lightswitch',
                heading: 'Notify'|t('guest-entries-notification'),
                thin: true,
            },
            emailTo: {
                type: 'singleline',
                heading: 'Recipients'|t('guest-entries-notification'),
            },
            emailSubject: {
                type: 'singleline',
                heading: 'Subject'|t('guest-entries-notification'),
            },
            template: {
                type: 'singleline',
                heading: 'Template'|t('app'),
                code: true,
            },
        },
        rows: sectionRows,
        staticRows: true,
        allowAdd: false,
        allowDelete: false,
        allowReorder: false,
    }) }}
{% else %}
    <h2>{{ 'Section Settings'|t('guest-entries-notification') }}</h2>
    <p class="warning">{{ 'No section allows guest submissions yet. Turn on “Allow guest submissions” for a section in the Guest Entries plugin settings, then come back here to enable its notifications.'|t('guest-entries-notification') }}</p>
{% endif %}

{% if isMultiSite %}
    {{ forms.editableTableField({
        label: 'Site Settings'|t('guest-entries-notification'),
        instructions: 'Give a site its own recipients or subject. Emails are always written in the language of the site the entry was submitted to. Section settings take priority over site settings.'|t('guest-entries-notification'),
        id: 'sites',
        name: 'sites',
        cols: {
            heading: {
                type: 'heading',
                heading: 'Site'|t('app'),
                thin: true,
            },
            emailTo: {
                type: 'singleline',
                heading: 'Recipients'|t('guest-entries-notification'),
            },
            emailSubject: {
                type: 'singleline',
                heading: 'Subject'|t('guest-entries-notification'),
            },
        },
        rows: siteRows,
        staticRows: true,
        allowAdd: false,
        allowDelete: false,
        allowReorder: false,
    }) }}
{% endif %}

<hr>

<h2>{{ 'Test Email'|t('guest-entries-notification') }}</h2>

<p>{{ 'Sends a notification for the most recent entry to your own email address ({email}), using the saved settings. Save any changes first.'|t('guest-entries-notification', { email: currentUser.email }) }}</p>

<div class="buttons">
    <button type="button" class="btn formsubmit" data-action="guest-entries-notification/test/send" data-redirect="{{ 'settings/plugins/guest-entries-notification'|hash }}">{{ 'Send test email'|t('guest-entries-notification') }}</button>
</div>
