{# Guest Entries Notification plugin settings #}

{% import "_includes/forms" as forms %}

{% if not guestEntriesAvailable %}
    <blockquote class="note warning">
        <p>{{ 'The Guest Entries plugin isn’t installed or enabled. Guest Entries Notification can’t send any notifications without it.'|t('guest-entries-notification') }}</p>
    </blockquote>
{% endif %}

<h2>{{ 'Sender'|t('guest-entries-notification') }}</h2>

{{ forms.textField({
    label: 'From Email'|t('guest-entries-notification'),
    instructions: 'The address notification emails are sent from. Leave blank to use the system email address.'|t('guest-entries-notification'),
    id: 'fromEmail',
    name: 'fromEmail',
    placeholder: systemFromEmail,
    value: settings.fromEmail,
    errors: settings.getErrors('fromEmail'),
}) }}

{{ forms.textField({
    label: 'From Name'|t('guest-entries-notification'),
    instructions: 'The sender name. Leave blank to use the system sender name.'|t('guest-entries-notification'),
    id: 'fromName',
    name: 'fromName',
    placeholder: systemFromName,
    value: settings.fromName,
}) }}

{{ forms.textField({
    label: 'Reply-To'|t('guest-entries-notification'),
    instructions: 'Where replies should go. This can be an entry value, such as `{email}` for a field with the handle `email`, so you can reply straight to the person who submitted the entry.'|t('guest-entries-notification'),
    id: 'replyTo',
    name: 'replyTo',
    value: settings.replyTo,
}) }}

{{ forms.lightswitchField({
    label: 'Send through the queue'|t('guest-entries-notification'),
    instructions: 'Send notifications in a background job, so the form responds straight away and a failed email can be retried. Turn this off to send the email while the form is being submitted.'|t('guest-entries-notification'),
    id: 'useQueue',
    name: 'useQueue',
    on: settings.useQueue,
}) }}

<hr>

{% if sectionRows|length %}
    {{ forms.editableTableField({
        label: 'Section Settings'|t('guest-entries-notification'),
        instructions: 'Only sections that allow guest submissions in the Guest Entries plugin are listed, and notifications are off until you turn on Notify. Add several recipients by separating them with commas. Leave Recipients blank to use the system email address, Subject blank for “New Entry Created”, and Template blank for the built-in email.'|t('guest-entries-notification'),
        id: 'sections',
        name: 'sections',
        cols: {
            heading: {
                type: 'heading',
                heading: 'Section'|t('app'),
                thin: true,
            },
            enabled: {
                type: 'lightswitch',
                heading: 'Notify'|t('guest-entries-notification'),
                thin: true,
            },
            emailTo: {
                type: 'singleline',
                heading: 'Recipients'|t('guest-entries-notification'),
                info: 'Separate several email addresses with commas, e.g. `editor@example.com, admin@example.com`.'|t('guest-entries-notification'),
                placeholder: 'editor@example.com, admin@example.com',
            },
            emailSubject: {
                type: 'singleline',
                heading: 'Subject'|t('guest-entries-notification'),
                info: 'Can include entry values, e.g. `New entry: {title}`.'|t('guest-entries-notification'),
                placeholder: 'New entry: {title}',
            },
            template: {
                type: 'template',
                heading: 'Template'|t('app'),
                info: 'A template in your `templates/` folder for the email body. It receives `entry` and `subject` variables.'|t('guest-entries-notification'),
                code: true,
            },
        },
        rows: sectionRows,
        staticRows: true,
        allowAdd: false,
        allowDelete: false,
        allowReorder: false,
    }) }}
{% else %}
    <h2>{{ 'Section Settings'|t('guest-entries-notification') }}</h2>
    <p class="warning">{{ 'No section allows guest submissions yet. Turn on “Allow guest submissions” for a section in the Guest Entries plugin settings, then come back here to enable its notifications.'|t('guest-entries-notification') }}</p>
{% endif %}

{% if isMultiSite %}
    {{ forms.editableTableField({
        label: 'Site Settings'|t('guest-entries-notification'),
        instructions: 'Give a site its own recipients or subject, used when the section doesn’t set one. Separate several recipients with commas. Emails are always written in the language of the site the entry was submitted to.'|t('guest-entries-notification'),
        id: 'sites',
        name: 'sites',
        cols: {
            heading: {
                type: 'heading',
                heading: 'Site'|t('app'),
                thin: true,
            },
            emailTo: {
                type: 'singleline',
                heading: 'Recipients'|t('guest-entries-notification'),
                info: 'Separate several email addresses with commas.'|t('guest-entries-notification'),
            },
            emailSubject: {
                type: 'singleline',
                heading: 'Subject'|t('guest-entries-notification'),
            },
        },
        rows: siteRows,
        staticRows: true,
        allowAdd: false,
        allowDelete: false,
        allowReorder: false,
    }) }}
{% endif %}
